# ══════════════════════════════════════════════════════════════════════════════
# VIDYUTPRAGYA CONFIGURATION (.env)
# ══════════════════════════════════════════════════════════════════════════════

# ── ENVIRONMENT ───────────────────────────────────────────────────────────────
# Set to 'False' on production server to disable dev features and fix ALLOWED_HOSTS.
DJANGO_DEBUG=True
# Comma-separated list of domains allowed to host the Django API.
# Use '*' for initial testing, then restrict to your domain (e.g., 'api.example.com').
DJANGO_ALLOWED_HOSTS=*

# ── FRONTEND ──────────────────────────────────────────────────────────────────
# Default app API is Django via relative '/api'.
# FastAPI is reserved for model/forecast work via '/ml-api' in Vite dev.
# VITE_DJANGO_API_BASE_URL=http://your-server-ip:8001
# VITE_FASTAPI_API_BASE_URL=http://your-server-ip:8000

# ── SHARED AUTHENTICATION ─────────────────────────────────────────────────────
# This key MUST match between FastAPI and Django for internal communication.
API_SECRET_KEY=flagbearer
# Used specifically by the FastAPI backend to fetch weather from the Django API.
PIPELINE_API_TOKEN=flagbearer

# ── MYSQL DATABASE ────────────────────────────────────────────────────────────
# Used by both FastAPI (config.py) and Django (settings.py).
MYSQL_HOST=insights-db.cwrczdscnsl8.ap-south-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DB=rishu_db
MYSQL_USER=admin
MYSQL_PASSWORD=123gnaenergy

# ── BACKEND (FASTAPI) ─────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
# Comma-separated list of origins allowed to call the FastAPI API.
# CORS_ORIGINS=http://localhost:3000,http://your-domain.com

# ── PIPELINE INTERNALS ────────────────────────────────────────────────────────
# URL used by FastAPI to talk to the Django weather endpoints.
# If running on the same server, localhost:8001 usually works for Django.
PIPELINE_API_BASE_URL=http://localhost:8001
