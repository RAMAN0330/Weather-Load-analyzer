# In dev mode, requests go through the Vite proxy (/api -> localhost:8000).
# Only set VITE_API_BASE_URL for production builds where no proxy exists.
# VITE_API_BASE_URL=http://localhost:8000

# ── MySQL (shared by config.py and django_api/settings.py) ──────────────────
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=rishu_db
# MYSQL_USER=admin
# MYSQL_PASSWORD=

# ── API token (used by api.py AND django_api) ────────────────────────────────
# API_SECRET_KEY=your-secret-here

# ── Pipeline data source (set to local Django server to avoid remote call) ───
PIPELINE_API_BASE_URL=http://localhost:8001
# PIPELINE_API_TOKEN=flagbearer
