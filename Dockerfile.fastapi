# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

# libgomp1: OpenMP runtime for lightgbm / xgboost. Everything else ships as wheels.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# BuildKit cache keeps downloaded wheels between builds, so a requirements
# change only fetches what changed.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY backend/ ./backend/
COPY build_final_data.py .
COPY mockdata/ ./mockdata/
COPY db/ ./db/

ENV PORT=8000
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
